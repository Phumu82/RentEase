<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. The real Material 3 look is applied by RentEaseTheme
         in Compose (presentation/theme/Theme.kt); this XML theme only controls
         the system window before Compose takes over.

         It deliberately extends an AppCompat theme (not Theme.Material3.*, which
         lives in com.google.android.material - a library this project does not
         depend on). MainActivity is an AppCompatActivity so that
         AppCompatDelegate.setApplicationLocales() (Settings > Language) works on
         API 26-32 as well as API 33+. -->
    <style name="Theme.RentEase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/rentease_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
